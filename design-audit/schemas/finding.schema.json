{
  "$id": "https://morzsa.local/audit/finding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "confirmed-bug",
        "reproducible-usability",
        "visual-inconsistency",
        "accessibility",
        "product-opportunity",
        "hypothesis",
        "environment-limitation"
      ]
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "affectedScreen": {
      "type": "string",
      "minLength": 1
    },
    "routeOrComponent": {
      "type": "string",
      "minLength": 1
    },
    "reproductionSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedBehavior": {
      "type": "string",
      "minLength": 1
    },
    "actualBehavior": {
      "type": "string",
      "minLength": 1
    },
    "userImpact": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "screenshot",
              "trace",
              "dom",
              "network",
              "console",
              "test",
              "other"
            ]
          }
        },
        "required": [
          "path",
          "description",
          "kind"
        ]
      }
    },
    "screenshotRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendedSolution": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validationStatus": {
      "enum": [
        "reproduced",
        "verified",
        "observed-once",
        "needs-validation",
        "not-testable",
        "rejected"
      ]
    },
    "duplicateKey": {
      "type": "string",
      "minLength": 1
    },
    "regressionTests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "title",
    "category",
    "severity",
    "priority",
    "confidence",
    "affectedScreen",
    "routeOrComponent",
    "reproductionSteps",
    "expectedBehavior",
    "actualBehavior",
    "userImpact",
    "evidence",
    "screenshotRefs",
    "sourceFiles",
    "recommendedSolution",
    "acceptanceCriteria",
    "validationStatus"
  ]
}
